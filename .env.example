# Copy this file to .env.local and ask Taoufik for the real values.
# .env.local is git-ignored — never commit secrets.

# Neon Postgres — pooled connection string, used by the app
# (Neon console -> Connect -> "Pooled connection"; host contains -pooler)
DATABASE_URL=
# Direct connection string (same, without -pooler) — only for migrations
DATABASE_URL_UNPOOLED=

# Auth.js secret — generate one with:  openssl rand -base64 32   (Week 2)
AUTH_SECRET=

# Vercel Blob token for photo uploads (Week 2)
BLOB_READ_WRITE_TOKEN=
