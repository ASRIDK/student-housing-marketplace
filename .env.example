# Copy this file to .env.local and ask Taoufik for the real values.
# .env.local is git-ignored — never commit secrets.

# Neon Postgres — pooled connection string, used by the app
# (Neon console -> Connect -> "Pooled connection"; host contains -pooler)
DATABASE_URL=
# Direct connection string (same, without -pooler) — only for migrations
DATABASE_URL_UNPOOLED=

# Auth.js secret — generate one with:  openssl rand -base64 32   (Week 2)
AUTH_SECRET=

# Vercel Blob token for photo uploads (Week 2)
BLOB_READ_WRITE_TOKEN=

# Google Gemini: powers both AI features, "Fill in from my photos" and
# "Write it for me". Server-only. Without it both return a 503 and the form
# says so. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: the model tried first (default: gemini-3.8-flash), and the ones
# tried next when it is busy or slow (default: gemini-3.6-flash,gemini-3.5-flash-lite)
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
